// STATUS: DRAFT - UNVERIFIED - requires human review at Gate G1 (rev B)
// MicroScout rev B block diagram. Render: dot -Tsvg block-diagram.dot -o block-diagram.svg
digraph microscout {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.55, splines=true,
         label="MicroScout rev B - 2S brushless, two-board stack (DRAFT - UNVERIFIED)", labelloc=t];
  node  [shape=box, style="rounded,filled", fillcolor="#f4f6f8", color="#55606e", fontname="Helvetica", fontsize=10];
  edge  [color="#55606e", fontname="Helvetica", fontsize=8];

  subgraph cluster_power {
    label="Power (2S, on the FC board)"; style="rounded,dashed"; color="#b06000";
    BATT  [label="2S LiHV 550 mAh\nkeyed XT30 + JST-XH balance\n(no reverse FET - D-035, OQ-2)", fillcolor="#fff1db"];
    SHUNT [label="RS1 1 mOhm, high side\n+ U9 INA226 (0x40)"];
    DRV   [label="Q4 gate-driver supply switch\n(part TBD, D-036)"];
    USB   [label="USB-C J1 + USBLC6\nCC 5.1k pull-downs"];
    CHG   [label="U2 BQ25887\n2S boost charger\n+ cell balancing"];
    PWR   [label="U8 LTC2954-1\nsoft switch (logic + driver supply)\nKILL from MCU + U23 UVLO"];
    B33   [label="U3 TPS62162\nbuck 3.3 V (1 A)"];
    B5    [label="U4 TPS62133\nbuck 5 V (3 A)"];
    LDO   [label="LDOs: 1.8 V IMU,\n1.9-2.0 V flow core,\n2.8/1.2 V camera"];
  }

  subgraph cluster_fc {
    label="Flight-controller board (40 mm, notched)"; style="rounded,dashed"; color="#1f5fa8";
    MCU [label="U1 ESP32-S3-WROOM-1-N8R2\nflight control + Wi-Fi + BLE\nMJPEG stream", fillcolor="#e3eefb"];
    IMU [label="U12 ICM-42688-P\n(SPI, 8 kHz)", fillcolor="#e6f4e7"];
    EXP [label="2x TCA6408A\nXSHUT / LPn / status"];
    SEN [label="BMP390 · QMC5883P\n5x ToF (VL53L1X x4,\nVL53L5CX 8x8)"];
    FLOW [label="Sensor pod: PMW3901\nflow + down ToF\n(OQ-4)"];
    CAM [label="OV2640 camera\n(24-pin FPC)"];
    RX  [label="ELRS receiver\n(CRSF, 5 V)"];
    LED [label="4x WS2812B-2020\n+ buzzer"];
  }

  subgraph cluster_esc {
    label="4-in-1 ESC board (30 mm, AM32) - D-029"; style="rounded,dashed"; color="#8e24aa";
    ESC [label="4x AT32F421 (AM32)\n4x FD6288Q gate drivers\n24x HL60N03D FETs", fillcolor="#f3e5f5"];
    MOT [label="4x EX1103 11000KV\n2-inch 3-blade props\nin ducts", fillcolor="#f3e5f5"];
  }

  BATT -> SHUNT [color="#b06000", penwidth=2.4, label="VBAT 6.0-8.7 V"];
  SHUNT -> ESC [color="#b06000", penwidth=2.4, label="FET power stage (always connected)"];
  SHUNT -> PWR [color="#b06000"];
  USB -> CHG [color="#b06000", label="VBUS 5 V"];
  CHG -> BATT [color="#b06000", label="charge + balance"];
  PWR -> B33 [color="#b06000", label="EN"];
  PWR -> B5 [color="#b06000", label="EN"];
  PWR -> DRV [color="#b06000", label="EN"];
  SHUNT -> DRV [color="#b06000"];
  DRV -> ESC [color="#b06000", label="driver VCC"];
  B33 -> MCU [color="#b06000", label="3V3"];
  B33 -> ESC [color="#b06000", label="3V3 logic"];
  B33 -> LDO [color="#b06000"];
  B5 -> RX [color="#b06000"]; B5 -> LED [color="#b06000"];
  ESC -> MOT [color="#b06000", penwidth=2.4, label="3-phase"];

  MCU -> ESC [dir=both, label="4x bidirectional DShot\n(GPIO2/21/38/47)"];
  MCU -> IMU [dir=both, label="SPI2"];
  MCU -> FLOW [dir=both, label="SPI2 + I2C"];
  MCU -> EXP [dir=both, label="I2C 400 kHz"];
  MCU -> SEN [dir=both, label="I2C"];
  EXP -> SEN [label="XSHUT / LPn"];
  MCU -> CAM [dir=both, label="DVP + SCCB"];
  MCU -> RX [dir=both, label="UART1 CRSF"];
  MCU -> LED [label="GPIO45 / 46"];
  MCU -> SHUNT [dir=both, label="I2C + ALERT"];
  MCU -> PWR [style=dotted, label="KILL"];
  CHG -> MCU [style=dotted, label="I2C status"];
}

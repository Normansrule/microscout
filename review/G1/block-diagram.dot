// STATUS: DRAFT - UNVERIFIED - requires human review at Gate G1
// MicroScout drone PCB block diagram. Render: dot -Tsvg block-diagram.dot -o block-diagram.svg
digraph microscout {
  graph [rankdir=LR, fontname="Helvetica", fontsize=11, nodesep=0.25, ranksep=0.55, splines=true,
         label="MicroScout drone PCB - G1 block diagram (DRAFT - UNVERIFIED)", labelloc=t];
  node  [shape=box, style="rounded,filled", fillcolor="#f4f6f8", color="#55606e", fontname="Helvetica", fontsize=10];
  edge  [color="#55606e", fontname="Helvetica", fontsize=8];

  subgraph cluster_power {
    label="Power (1S)"; style="rounded,dashed"; color="#b06000";
    BATT   [label="1S LiPo 660 mAh\nconnector: OQ-2 open\n(PH2.0 vs BT2.0)", fillcolor="#fff1db"];
    F1     [label="F1 fuse 15 A\n0451015.MRL"];
    SHUNT  [label="RS1 5 mOhm\n+ U9 INA226 (I2C 0x40)"];
    Q1     [label="Q1 reverse-battery\nP-FET DMP2008UFG"];
    USB    [label="USB-C J1\n+ USBLC6-2SC6 ESD\nCC 5.1k pull-downs"];
    CHG    [label="U2 BQ24074\ncharger + power path\nI_CHG ~500 mA"];
    PWR    [label="U8 LTC2954-1\npushbutton on/off\nKILL from MCU + U23 UVLO"];
    Q2     [label="Q2 motor-rail\nP-FET switch (via Q3)"];
    REG33  [label="U3 TPS63802\nbuck-boost 3.3 V"];
    REG5   [label="U4 TPS61023\nboost 5 V"];
    LDO18A [label="U5 TLV70018\n1.8 V (IMU core only)"];
    LDO18B [label="U5B LDO 1.9-2.0 V\n(flow core, TBD)"];
    LDOCAM [label="U6/U7 ME6211\n2.8 V AVDD / 1.2 V DVDD\n(1.5 V option)\nCE = CAM_PWR_EN"];
  }

  subgraph cluster_mcu {
    label="Compute + radio"; style="rounded,dashed"; color="#1f5fa8";
    MCU [label="U1 ESP32-S3-WROOM-1-N8R2\n8 MB flash, 2 MB quad PSRAM\nWi-Fi (UDP, MJPEG) + BLE\nPCB antenna at board edge", fillcolor="#e3eefb"];
    DBG [label="Debug pads\nUART0 + EN + IO0\nBOOT / RESET buttons"];
  }

  subgraph cluster_sense {
    label="Sensors"; style="rounded,dashed"; color="#2e7d32";
    IMU  [label="U12 BMI270 IMU\n(SPI, near CoM)", fillcolor="#e6f4e7"];
    FLOW [label="U20 PMW3901 + lens\n(SPI, downward)\nCONDITIONAL - OQ-4", fillcolor="#e6f4e7"];
    BARO [label="U13 BMP390 (0x76)"];
    MAG  [label="U14 QMC5883P (0x2C)\naway from motor current"];
    TOFD [label="U15 VL53L1X down"];
    TOFS [label="U16-18 VL53L1X\nleft / right / rear"];
    TOFF [label="U19 VL53L5CX\nforward 8x8"];
    EXP  [label="U10/U11 TCA6408A\n(0x20 / 0x21)\nXSHUT, LPn, resets, status"];
    CAM  [label="OV2640 module\n24-pin 0.5 mm FPC (J3)", fillcolor="#e6f4e7"];
  }

  subgraph cluster_act {
    label="Actuators + I/O"; style="rounded,dashed"; color="#8e24aa";
    MOT  [label="4x AO3400A low-side\n+ B5819W flyback\n100k gate pull-downs", fillcolor="#f3e5f5"];
    M    [label="4x 8520 brushed motors\n55 mm props", fillcolor="#f3e5f5"];
    LED  [label="4x WS2812B-2020\n(via SN74AHCT1G125)"];
    BZ   [label="MLT-5020 buzzer\n(via AO3400A)"];
    RX   [label="ELRS nano receiver\n(CRSF 420000 baud, 5 V)"];
  }

  // power flow
  BATT -> Q1 -> F1 -> SHUNT [color="#b06000", penwidth=2.2, label="VBAT"];
  SHUNT -> Q2 [color="#b06000", penwidth=2.2];
  Q2 -> M  [color="#b06000", penwidth=2.2, label="VMOT"];
  SHUNT -> CHG [color="#b06000", label="BAT pin"];
  USB -> CHG [color="#b06000", label="VBUS 5 V"];
  CHG -> REG33 [color="#b06000", label="OUT (sys)"];
  CHG -> REG5  [color="#b06000"];
  PWR -> REG33 [style=dashed, label="EN"];
  PWR -> REG5  [style=dashed, label="EN"];
  PWR -> Q2    [style=dashed, label="EN via Q3"];
  REG33 -> MCU [color="#b06000", label="3V3"];
  REG33 -> LDO18A [color="#b06000"];
  REG33 -> LDO18B [color="#b06000"];
  REG33 -> LDOCAM [color="#b06000"];
  LDO18A -> IMU [color="#b06000", label="VDD 1.8"];
  LDO18B -> FLOW [color="#b06000", label="VDD 1.8"];
  LDOCAM -> CAM [color="#b06000"];
  REG5 -> LED [color="#b06000", label="5V"];
  REG5 -> RX  [color="#b06000", label="5V"];

  // signals
  I2C [label="I2C bus 400 kHz\nGPIO39 SDA / GPIO40 SCL", shape=box, style="filled", fillcolor="#fffde7"];
  SPI [label="SPI2 <=10 MHz\nGPIO11/12/13", shape=box, style="filled", fillcolor="#fffde7"];
  USB -> MCU [label="USB D-/D+"];
  MCU -> SPI [dir=both];
  SPI -> IMU [dir=both, label="CS GPIO35, INT GPIO37"];
  SPI -> FLOW [dir=both, label="CS GPIO36"];
  MCU -> CAM  [dir=both, label="DVP 8-bit + sync (12 GPIO)"];
  MCU -> I2C [dir=both];
  I2C -> EXP; I2C -> BARO; I2C -> MAG; I2C -> TOFD; I2C -> TOFS; I2C -> TOFF; I2C -> SHUNT; I2C -> CAM [label="SCCB 0x30"];
  EXP -> TOFD [label="XSHUT"]; EXP -> TOFS [label="XSHUT x3"]; EXP -> TOFF [label="LPn"];
  EXP -> CAM  [label="PWDN/RESET"]; EXP -> LDOCAM [label="CAM_PWR_EN"];
  EXP -> MCU [label="INT (GPIO3)", style=dotted];
  CHG -> EXP [label="CHG, PGOOD", style=dotted];
  PWR -> EXP [label="button INT", style=dotted];
  MCU -> PWR [label="KILL (GPIO48)", style=dotted];
  MCU -> MOT [label="4x PWM (GPIO2/21/38/47)"];
  MOT -> M;
  MCU -> LED [label="GPIO45"];
  MCU -> BZ  [label="GPIO46"];
  MCU -> RX  [dir=both, label="UART1 (GPIO41/42)"];
  MCU -> DBG [dir=both];
}

// STATUS: DRAFT - UNVERIFIED - requires human review at Gate G2
// MicroScout G2 block diagram (generated by tools/viz/blockdiagram.py from this template)
digraph microscout_g2 {
  graph [rankdir=TB, bgcolor="#ffffff", fontname="Inter", fontsize=13, fontcolor="#0b0b0b", nodesep=0.3, ranksep=0.45,
         pad=0.3, newrank=true, label="MicroScout - G2 schematic architecture (DRAFT - UNVERIFIED)", labelloc=t];
  node  [shape=box, style="rounded,filled", fillcolor="#f4f6f8", color="#9aa3ad", fontname="Inter", fontsize=11, fontcolor="#0b0b0b", penwidth=1.2, margin="0.12,0.06"];
  edge  [color="#9aa3ad", fontname="Inter", fontsize=9, fontcolor="#52514e", arrowsize=0.7, penwidth=1.1];

  subgraph cluster_pwr {
    label="Power  (flight-controller board)"; style="rounded,filled"; fillcolor="#fff4e5"; color="#d08a2a"; fontcolor="#0b0b0b"; fontsize=12;
    BAT  [label="2S LiHV 550 mAh\nXT30 + balance lead", fillcolor="#ffffff", penwidth=2, color="#c26a00"];
    USB  [label="USB-C\n+ USBLC6 ESD"];
    SNS  [label="1 mΩ shunt\n+ INA226"];
    CHG  [label="BQ25887\n2S charger + balancing"];
    OR   [label="VLOGIC\nSS34 diode-OR"];
    SW   [label="LTC2954 soft switch\n+ TLV6700 low-battery cut-off"];
    B33  [label="TPS62162\n3.3 V"];
    B5   [label="TPS62133\n5 V"];
    DRV  [label="TPS22810 switch\n+ MT3608 → 9.6 V"];
    {rank=same; USB; BAT;}
    {rank=same; CHG; SNS;}
    {rank=same; OR; SW;}
  }

  subgraph cluster_fc {
    label="Flight controller (40 mm)"; style="rounded,filled"; fillcolor="#eaf2fc"; color="#2a78d6"; fontcolor="#0b0b0b"; fontsize=12;
    MCU  [label="ESP32-S3-WROOM-1\nflight control · Wi-Fi · BLE · camera stream", fillcolor="#ffffff", penwidth=2, color="#2a78d6", fontsize=12];
    IMU  [label="ICM-42688-P IMU\nSPI, 8 kHz"];
    FLOW [label="Flow deck v2\nflow + down ToF"];
    I2C  [label="I²C sensors\nBMP388 · QMC5883P · 2× TCA6408A"];
    CAM  [label="OV2640 camera\n2.8 V / 1.2 V LDOs"];
    RX   [label="ExpressLRS\nreceiver"];
    LED  [label="4× WS2812B\n+ buzzer"];
  }

  subgraph cluster_sat {
    label="ToF satellites"; style="rounded,filled"; fillcolor="#e9f6ee"; color="#1baf7a"; fontcolor="#0b0b0b"; fontsize=12;
    TOF  [label="3× VL53L1X (sides, rear)\n1× VL53L5CX 8×8 (front)"];
  }

  subgraph cluster_esc {
    label="4-in-1 ESC (30 mm, AM32)"; style="rounded,filled"; fillcolor="#f5ecfa"; color="#8e44ad"; fontcolor="#0b0b0b"; fontsize=12;
    ESC  [label="4× AT32F421 + FD6288Q\n24× 30 V MOSFETs", fillcolor="#ffffff", penwidth=2, color="#8e44ad"];
    E33  [label="TPS62162\n3.3 V for the MCUs"];
    MOT  [label="4× EX1103 11000KV\n2-inch props in ducts"];
  }

  LEG [shape=plaintext, style="", fontsize=12, fontcolor="#52514e",
       label="Legend\l━━  power (thick = battery current)\l- - -  USB-only logic supply\l──  data / control\lNothing here is built or tested.\l"];
  {rank=same; LEG; USB;}

  // power paths
  BAT -> SNS [color="#c26a00", penwidth=2.4];
  USB -> CHG [color="#c26a00", label="5 V"];
  CHG -> BAT [color="#c26a00", label="charge"];
  SNS -> OR  [color="#c26a00"];
  USB -> OR  [color="#c26a00", style=dashed];
  OR  -> SW  [color="#c26a00", constraint=false];
  SW  -> B33 [color="#c26a00", label="EN"];
  SW  -> B5  [color="#c26a00", label="EN"];
  SW  -> DRV [color="#c26a00", label="EN"];
  SNS -> ESC [color="#c26a00", penwidth=2.4, label="battery (always connected)"];
  DRV -> ESC [color="#c26a00", label="9.6 V drivers"];
  DRV -> E33 [color="#c26a00"];
  E33 -> ESC [color="#c26a00"];
  ESC -> MOT [color="#c26a00", penwidth=2.4, label="3-phase"];
  B33 -> MCU [color="#c26a00", label="3.3 V"];
  B5  -> RX  [color="#c26a00", label="5 V"];

  // signals
  MCU -> IMU  [dir=both, label="SPI"];
  MCU -> FLOW [dir=both, label="SPI + I²C"];
  MCU -> I2C  [dir=both, label="I²C 400 kHz"];
  MCU -> TOF  [dir=both, label="I²C"];
  MCU -> CAM  [dir=both, label="DVP + SCCB"];
  MCU -> RX   [dir=both, label="CRSF"];
  MCU -> LED  [label="SPI3 data"];
  MCU -> ESC  [dir=both, label="4× bidirectional DShot"];
}

  (text "Soft power switch - LTC2954-1 (datasheet 2954fb, Fig. 5 values for ONT/PDT)"
    (at 394.816 33.48 0)
    (effects
      (font (size 1.6 1.6))
      (justify left bottom))
    (uuid "2a3e114a-f293-5fb2-83b0-717f0d1bbec5"))
  (text "EN (open drain) enables the 3.3 V and 5 V bucks and the ESC gate-driver supply switch U24 (D-036)."
    (at 394.816 36.68 0)
    (effects
      (font (size 1.15 1.15))
      (justify left bottom))
    (uuid "51674fa3-0681-5991-8a63-dca755498e32"))
  (text "KILL: 100 k pull-up to 3V3; pulled low by the MCU through D5 (GPIO48 cannot hold KILL high, D-055) or by"
    (at 394.816 39.88 0)
    (effects
      (font (size 1.15 1.15))
      (justify left bottom))
    (uuid "24800261-a429-58a9-9b38-0b736da0e2dc"))
  (text "the undervoltage detector U23 through Q5 (disabled while USB is present, D-055). Vf(D5) at 33 uA ~0.2 V < 0.57 V."
    (at 394.816 43.08 0)
    (effects
      (font (size 1.15 1.15))
      (justify left bottom))
    (uuid "a7bccaba-0e75-5bd1-8adf-1abd629133aa"))
  (text "t_ON = 0.033 uF / 1.56e-4 uF/ms + 1 ms = 213 ms press to turn on; C_PDT 1 uF -> 6.4 s power-down window."
    (at 394.816 46.28 0)
    (effects
      (font (size 1.15 1.15))
      (justify left bottom))
    (uuid "453913f8-e434-553d-aee9-b8b59123f941"))
